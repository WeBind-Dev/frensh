</style>

<script>
  import { parisMinutes } from '../scripts/frensh';
  const toMin = (s: string) => { const [h, m] = s.split(':').map(Number); return h * 60 + (m || 0); };
  const mark = () => {
    const now = parisMinutes();
    document.querySelectorAll<HTMLElement>('.moment').forEach((el) => {
      const a = toMin(el.dataset.from || '0:0'); const b = toMin(el.dataset.to || '0:0');
      el.classList.toggle('is-now', now >= a && now < b);
    });
  };
  mark(); setInterval(mark, 60_000);

  // Onglets de la carte : sans JS, toutes les rubriques restent affichées les unes sous les autres.
  const carte = document.querySelector<HTMLElement>('.carte');
  const tablist = carte?.querySelector<HTMLElement>('[data-tabs]');
  if (carte && tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls') || '')?.classList.toggle('is-active', on);
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (k) { e.preventDefault(); select(tabs[(i + k + tabs.length) % tabs.length], true); }
        if (e.key === 'Home') { e.preventDefault(); select(tabs[0], true); }
        if (e.key === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
      });
    });
    tablist.hidden = false;
    carte.classList.add('has-tabs');
    select(tabs[0]);
  }
</script>
