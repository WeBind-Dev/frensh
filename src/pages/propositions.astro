---
import '@fontsource-variable/figtree';
import Base from '../layouts/Base.astro';
const props = [
  { n: 1, href: '/', title: 'Le Marché', img: '/images/marche-forville-fruits.jpg', line: 'FREnSH comme un étal du Marché Forville : papier kraft, ardoises écrites à la craie, cagettes et nappe rouge d’étal. Le « fresh » se montre.', mood: 'Chaleureux, artisanal, le plus « fait maison »' },
  { n: 2, href: '/tableau', title: 'Le Tableau des départs', img: '/images/service-terrasse.jpg', line: 'La journée affichée comme un tableau de gare à palettes : ce qui est servi maintenant, ce qui part ensuite, à combien de minutes à pied. Les palettes tournent pour de vrai.', mood: 'Graphique, ludique, très pratique' },
  { n: 3, href: '/journee', title: 'La Journée', img: '/images/kiosque-allees-nuit.jpg', line: 'On descend la page comme on traverse la journée, de 9h à 22h30. La lumière change avec l’heure, du matin laiteux à la nuit du kiosque.', mood: 'Immersif, lumineux, le plus « Riviera »' },
];
---
<Base noindex title="FREnSH · 3 propositions de site" description="Trois propositions de design pour le nouveau site du FREnSH, brasserie à Cannes.">
  <main class="i">
    <header>
      <img src="/images/logo-frensh.png" alt="FREnSH" width="72" height="80" />
      <h1>Trois propositions pour le nouveau site du FREnSH</h1>
      <p>Même contenu, trois façons de donner envie de venir rue Félix Faure. Chaque version est une vraie page qui marche : statut ouvert/fermé en direct, itinéraire, appel, carte complète, version anglaise (bouton EN).</p>
    </header>
    <ol>
      {props.map((p) => (
        <li>
          <a href={p.href}>
            <img src={p.img} alt="" loading={p.n === 1 ? 'eager' : 'lazy'} />
            <span class="n">Proposition {p.n}</span>
            <h2>{p.title}</h2>
            <p>{p.line}</p>
            <p class="mood">{p.mood}</p>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>
<style>
  .i { font: 400 1.05rem/1.55 'Figtree Variable', system-ui, sans-serif; color: #161616; background: #efeeea; min-height: 100vh; padding: clamp(24px, 5vw, 72px); }
  header { max-width: 70ch; margin-bottom: 40px; }
  header img { width: 64px; height: auto; margin-bottom: 18px; }
  h1 { font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.02; letter-spacing: -0.03em; margin: 0 0 14px; text-wrap: balance; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  li a { display: block; height: 100%; color: inherit; text-decoration: none; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 12px 30px -18px rgb(0 0 0 / 0.35); transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  li a:hover { transform: translateY(-4px); }
  li a:focus-visible { outline: 3px solid #c4161c; outline-offset: 4px; }
  li img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .n { display: block; margin: 18px 22px 4px; font-size: 0.85rem; font-weight: 600; color: #c4161c; }
  h2 { margin: 0 22px 8px; font-size: 1.6rem; letter-spacing: -0.02em; }
  li p { margin: 0 22px 12px; }
  .mood { color: #666; font-size: 0.9rem; padding-bottom: 12px; }
</style>
